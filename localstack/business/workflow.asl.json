{
  "Comment": "Native HTTP to local NLB TCP listener; no Lambda tasks. Docker network replaces AWS private connectivity only.",
  "StartAt": "ValidateBatch",
  "TimeoutSeconds": 240,
  "States": {
    "Claim": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Parameters": {
        "ApiEndpoint.$": "States.Format('${NlbBaseUrl}/api/v1/internal/purchases/{}/run', $.saleId)",
        "Method": "POST",
        "InvocationConfig": {
          "ConnectionArn": "${ConnectionArn}"
        },
        "Headers": {
          "Content-Type": "application/json",
          "X-Correlation-Id.$": "$.correlationId"
        },
        "RequestBody": {
          "eventId.$": "$.eventId",
          "owner.$": "$.owner",
          "operation": "claim"
        }
      },
      "TimeoutSeconds": 20,
      "ResultPath": "$.claim",
      "Retry": [
        {
          "ErrorEquals": [
            "States.Http.StatusCode.429",
            "States.Http.StatusCode.500",
            "States.Http.StatusCode.502",
            "States.Http.StatusCode.503",
            "States.Http.StatusCode.504",
            "States.Http.StatusCode.408",
            "States.Timeout"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "Claimed",
      "ResultSelector": {
        "body.$": "$.ResponseBody"
      }
    },
    "Claimed": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.claim.body.claimed",
          "BooleanEquals": true,
          "Next": "Document"
        }
      ],
      "Default": "Duplicate"
    },
    "Document": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Parameters": {
        "ApiEndpoint.$": "States.Format('${NlbBaseUrl}/api/v1/internal/purchases/{}/run', $.saleId)",
        "Method": "POST",
        "InvocationConfig": {
          "ConnectionArn": "${ConnectionArn}"
        },
        "Headers": {
          "Content-Type": "application/json",
          "X-Correlation-Id.$": "$.correlationId"
        },
        "RequestBody": {
          "eventId.$": "$.eventId",
          "owner.$": "$.owner",
          "operation": "document"
        }
      },
      "TimeoutSeconds": 20,
      "ResultPath": "$.document",
      "Retry": [
        {
          "ErrorEquals": [
            "States.Http.StatusCode.429",
            "States.Http.StatusCode.500",
            "States.Http.StatusCode.502",
            "States.Http.StatusCode.503",
            "States.Http.StatusCode.504",
            "States.Http.StatusCode.408",
            "States.Timeout"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "Policy",
      "ResultSelector": {
        "body.$": "$.ResponseBody"
      }
    },
    "Policy": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Parameters": {
        "ApiEndpoint.$": "States.Format('${NlbBaseUrl}/api/v1/internal/purchases/{}/run', $.saleId)",
        "Method": "POST",
        "InvocationConfig": {
          "ConnectionArn": "${ConnectionArn}"
        },
        "Headers": {
          "Content-Type": "application/json",
          "X-Correlation-Id.$": "$.correlationId"
        },
        "RequestBody": {
          "eventId.$": "$.eventId",
          "owner.$": "$.owner",
          "operation": "policy",
          "documentId.$": "$.document.body.documentId"
        }
      },
      "TimeoutSeconds": 20,
      "ResultPath": "$.policy",
      "Retry": [
        {
          "ErrorEquals": [
            "States.Http.StatusCode.429",
            "States.Http.StatusCode.500",
            "States.Http.StatusCode.502",
            "States.Http.StatusCode.503",
            "States.Http.StatusCode.504",
            "States.Http.StatusCode.408",
            "States.Timeout"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "Upload",
      "ResultSelector": {
        "body.$": "$.ResponseBody"
      }
    },
    "Upload": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Parameters": {
        "ApiEndpoint.$": "States.Format('${NlbBaseUrl}/api/v1/internal/purchases/{}/run', $.saleId)",
        "Method": "POST",
        "InvocationConfig": {
          "ConnectionArn": "${ConnectionArn}"
        },
        "Headers": {
          "Content-Type": "application/json",
          "X-Correlation-Id.$": "$.correlationId"
        },
        "RequestBody": {
          "eventId.$": "$.eventId",
          "owner.$": "$.owner",
          "operation": "upload",
          "documentId.$": "$.document.body.documentId",
          "policyId.$": "$.policy.body.policyId"
        }
      },
      "TimeoutSeconds": 20,
      "ResultPath": "$.upload",
      "Retry": [
        {
          "ErrorEquals": [
            "States.Http.StatusCode.429",
            "States.Http.StatusCode.500",
            "States.Http.StatusCode.502",
            "States.Http.StatusCode.503",
            "States.Http.StatusCode.504",
            "States.Http.StatusCode.408",
            "States.Timeout"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "CompletePolicy",
      "ResultSelector": {
        "body.$": "$.ResponseBody"
      }
    },
    "CompletePolicy": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Parameters": {
        "ApiEndpoint.$": "States.Format('${NlbBaseUrl}/api/v1/internal/purchases/{}/run', $.saleId)",
        "Method": "POST",
        "InvocationConfig": {
          "ConnectionArn": "${ConnectionArn}"
        },
        "Headers": {
          "Content-Type": "application/json",
          "X-Correlation-Id.$": "$.correlationId"
        },
        "RequestBody": {
          "eventId.$": "$.eventId",
          "owner.$": "$.owner",
          "operation": "completePolicy",
          "documentId.$": "$.document.body.documentId",
          "policyId.$": "$.policy.body.policyId"
        }
      },
      "TimeoutSeconds": 20,
      "ResultPath": "$.completion",
      "Retry": [
        {
          "ErrorEquals": [
            "States.Http.StatusCode.429",
            "States.Http.StatusCode.500",
            "States.Http.StatusCode.502",
            "States.Http.StatusCode.503",
            "States.Http.StatusCode.504",
            "States.Http.StatusCode.408",
            "States.Timeout"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "Release",
      "ResultSelector": {
        "body.$": "$.ResponseBody"
      }
    },
    "Release": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Parameters": {
        "ApiEndpoint.$": "States.Format('${NlbBaseUrl}/api/v1/internal/purchases/{}/run', $.saleId)",
        "Method": "POST",
        "InvocationConfig": {
          "ConnectionArn": "${ConnectionArn}"
        },
        "Headers": {
          "Content-Type": "application/json",
          "X-Correlation-Id.$": "$.correlationId"
        },
        "RequestBody": {
          "eventId.$": "$.eventId",
          "owner.$": "$.owner",
          "operation": "release",
          "documentId.$": "$.document.body.documentId",
          "policyId.$": "$.policy.body.policyId"
        }
      },
      "TimeoutSeconds": 20,
      "ResultPath": "$.release",
      "Retry": [
        {
          "ErrorEquals": [
            "States.Http.StatusCode.429",
            "States.Http.StatusCode.500",
            "States.Http.StatusCode.502",
            "States.Http.StatusCode.503",
            "States.Http.StatusCode.504",
            "States.Http.StatusCode.408",
            "States.Timeout"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "Finish",
      "ResultSelector": {
        "body.$": "$.ResponseBody"
      }
    },
    "Finish": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Parameters": {
        "ApiEndpoint.$": "States.Format('${NlbBaseUrl}/api/v1/internal/purchases/{}/run', $.saleId)",
        "Method": "POST",
        "InvocationConfig": {
          "ConnectionArn": "${ConnectionArn}"
        },
        "Headers": {
          "Content-Type": "application/json",
          "X-Correlation-Id.$": "$.correlationId"
        },
        "RequestBody": {
          "eventId.$": "$.eventId",
          "owner.$": "$.owner",
          "operation": "finish",
          "documentId.$": "$.document.body.documentId",
          "policyId.$": "$.policy.body.policyId"
        }
      },
      "TimeoutSeconds": 20,
      "ResultPath": "$.result",
      "Retry": [
        {
          "ErrorEquals": [
            "States.Http.StatusCode.429",
            "States.Http.StatusCode.500",
            "States.Http.StatusCode.502",
            "States.Http.StatusCode.503",
            "States.Http.StatusCode.504",
            "States.Http.StatusCode.408",
            "States.Timeout"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "Completed",
      "ResultSelector": {
        "body.$": "$.ResponseBody"
      }
    },
    "RecordFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Parameters": {
        "ApiEndpoint.$": "States.Format('${NlbBaseUrl}/api/v1/internal/purchases/{}/run', $.saleId)",
        "Method": "POST",
        "InvocationConfig": {
          "ConnectionArn": "${ConnectionArn}"
        },
        "Headers": {
          "Content-Type": "application/json",
          "X-Correlation-Id.$": "$.correlationId"
        },
        "RequestBody": {
          "eventId.$": "$.eventId",
          "owner.$": "$.owner",
          "operation": "fail",
          "error.$": "States.JsonToString($.failure)"
        }
      },
      "TimeoutSeconds": 20,
      "ResultPath": "$.recordedFailure",
      "Retry": [
        {
          "ErrorEquals": [
            "States.Http.StatusCode.429",
            "States.Http.StatusCode.500",
            "States.Http.StatusCode.502",
            "States.Http.StatusCode.503",
            "States.Http.StatusCode.504",
            "States.Http.StatusCode.408",
            "States.Timeout"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.recordingFailure",
          "Next": "Failed"
        }
      ],
      "Next": "Failed",
      "ResultSelector": {
        "body.$": "$.ResponseBody"
      }
    },
    "Failed": {
      "Type": "Fail",
      "Error": "PurchaseWorkflowFailed",
      "Cause": "Consult execution history and GET /purchases/{saleId}; retry explicitly after failure/lease expiry."
    },
    "Duplicate": {
      "Type": "Succeed"
    },
    "Completed": {
      "Type": "Succeed"
    },
    "ValidateBatch": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$[0]",
              "IsPresent": true
            },
            {
              "Variable": "$[1]",
              "IsPresent": false
            },
            {
              "Variable": "$[0].eventSource",
              "IsPresent": true
            },
            {
              "Variable": "$[0].eventSource",
              "StringEquals": "aws:sqs"
            },
            {
              "Variable": "$[0].body",
              "IsPresent": true
            },
            {
              "Variable": "$[0].body",
              "IsString": true
            }
          ],
          "Next": "ParseEvent"
        }
      ],
      "Default": "InvalidEvent"
    },
    "ParseEvent": {
      "Type": "Pass",
      "Parameters": {
        "event.$": "States.StringToJson($[0].body)",
        "owner.$": "$$.Execution.Id"
      },
      "Next": "ValidateEvent"
    },
    "ValidateEvent": {
      "Type": "Choice",
      "QueryLanguage": "JSONata",
      "Choices": [
        {
          "Condition": "{% $type($states.input.event) = 'object' and $states.input.event.type = 'PurchaseAccepted' and $type($states.input.event.version) = 'number' and $states.input.event.version = 1 and $type($states.input.event.generation) = 'number' and $states.input.event.generation >= 1 and $floor($states.input.event.generation) = $states.input.event.generation and $type($states.input.event.eventId) = 'string' and $exists($match($states.input.event.eventId, /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/)) and $type($states.input.event.saleId) = 'string' and $exists($match($states.input.event.saleId, /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/)) and $type($states.input.event.correlationId) = 'string' and $exists($match($states.input.event.correlationId, /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/)) and $states.input.event.saleId = $states.input.event.correlationId %}",
          "Next": "Normalize"
        }
      ],
      "Default": "InvalidEvent"
    },
    "Normalize": {
      "Type": "Pass",
      "Parameters": {
        "eventId.$": "$.event.eventId",
        "saleId.$": "$.event.saleId",
        "correlationId.$": "$.event.correlationId",
        "generation.$": "$.event.generation",
        "owner.$": "$.owner"
      },
      "Next": "Claim"
    },
    "InvalidEvent": {
      "Type": "Fail",
      "Error": "InvalidEvent",
      "Cause": "Expected one valid PurchaseAccepted SQS event"
    }
  }
}
