{
  "Comment": "Local integration fixture. No business workflow or outbox processing.",
  "StartAt": "InvokeDiagnostic",
  "States": {
    "InvokeDiagnostic": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {"FunctionName": "${DiagnosticLambdaArn}", "Payload.$": "$"},
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 30,
      "End": true
    }
  }
}
