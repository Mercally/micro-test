{
  "operation": "PutRule + PutTargets",
  "existingConfigurationPreserved": true,
  "rule": {
    "Name": "micro-test-local-publisher",
    "ScheduleExpression": "rate(1 minute)",
    "State": "ENABLED",
    "EventBusName": "default"
  },
  "targets": [
    {
      "Id": "publisher",
      "Arn": "arn:aws:lambda:us-east-1:000000000000:function:micro-test-local-publisher",
      "Input": "{\"limit\":20}"
    }
  ]
}
