{
  "Comment": "Acepta un trabajo en SQS. No invoca HTTP privado ni espera procesamiento. Consumidor pendiente en micro.",
  "StartAt": "Enqueue",
  "TimeoutSeconds": 60,
  "States": {
    "Enqueue": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Parameters": {
        "QueueUrl": "${QUEUE_URL}",
        "MessageBody.$": "States.JsonToString($)"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "End": true
    }
  }
}
