{
  "Comment": "Orquesta el registro de venta y los pasos de documentos y póliza.",
  "StartAt": "RegisterSale",
  "States": {
    "RegisterSale": {
      "Type": "Task",
      "Resource": "arn:aws:states:::apigateway:invoke",
      "Parameters": {
        "ApiEndpoint": "YOUR_API_ID.execute-api.YOUR_REGION.amazonaws.com",
        "Stage": "prod",
        "Path": "/api/v1/endpoint0/sales",
        "Method": "POST",
        "AuthType": "NO_AUTH",
        "RequestBody.$": "$"
      },
      "ResultSelector": {
        "saleId.$": "$.ResponseBody.saleId"
      },
      "ResultPath": "$.sale",
      "Retry": [{
        "ErrorEquals": ["States.ALL"],
        "IntervalSeconds": 1,
        "BackoffRate": 2.0,
        "MaxAttempts": 7
      }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "WorkflowFailed" }],
      "Next": "CreateDocument"
    },
    "CreateDocument": {
      "Type": "Task",
      "Resource": "arn:aws:states:::apigateway:invoke",
      "Parameters": {
        "ApiEndpoint": "YOUR_API_ID.execute-api.YOUR_REGION.amazonaws.com",
        "Stage": "prod",
        "Path": "/api/v1/endpoint1/documents",
        "Method": "POST",
        "AuthType": "NO_AUTH",
        "RequestBody": { "saleId.$": "$.sale.saleId" }
      },
      "ResultSelector": { "documentId.$": "$.ResponseBody.documentId" },
      "ResultPath": "$.document",
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "BackoffRate": 2.0, "MaxAttempts": 7 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "WorkflowFailed" }],
      "Next": "CreatePolicy"
    },
    "CreatePolicy": {
      "Type": "Task",
      "Resource": "arn:aws:states:::apigateway:invoke",
      "Parameters": {
        "ApiEndpoint": "YOUR_API_ID.execute-api.YOUR_REGION.amazonaws.com",
        "Stage": "prod",
        "Path": "/api/v1/endpoint2/policies",
        "Method": "POST",
        "AuthType": "NO_AUTH",
        "RequestBody": { "saleId.$": "$.sale.saleId" }
      },
      "ResultSelector": { "policyId.$": "$.ResponseBody.policyId" },
      "ResultPath": "$.policy",
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "BackoffRate": 2.0, "MaxAttempts": 7 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "WorkflowFailed" }],
      "Next": "UploadDocument"
    },
    "UploadDocument": {
      "Type": "Task",
      "Resource": "arn:aws:states:::apigateway:invoke",
      "Parameters": {
        "ApiEndpoint": "YOUR_API_ID.execute-api.YOUR_REGION.amazonaws.com",
        "Stage": "prod",
        "Path": "/api/v1/endpoint3/documents/upload",
        "Method": "POST",
        "AuthType": "NO_AUTH",
        "RequestBody": { "saleId.$": "$.sale.saleId", "documentId.$": "$.document.documentId" }
      },
      "ResultPath": "$.upload",
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "BackoffRate": 2.0, "MaxAttempts": 7 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "WorkflowFailed" }],
      "Next": "CompletePolicy"
    },
    "CompletePolicy": {
      "Type": "Task",
      "Resource": "arn:aws:states:::apigateway:invoke",
      "Parameters": {
        "ApiEndpoint": "YOUR_API_ID.execute-api.YOUR_REGION.amazonaws.com",
        "Stage": "prod",
        "Path": "/api/v1/endpoint4/policies/complete",
        "Method": "POST",
        "AuthType": "NO_AUTH",
        "RequestBody": { "saleId.$": "$.sale.saleId", "policyId.$": "$.policy.policyId" }
      },
      "ResultPath": "$.completion",
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "BackoffRate": 2.0, "MaxAttempts": 7 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "WorkflowFailed" }],
      "Next": "ReleaseDocument"
    },
    "ReleaseDocument": {
      "Type": "Task",
      "Resource": "arn:aws:states:::apigateway:invoke",
      "Parameters": {
        "ApiEndpoint": "YOUR_API_ID.execute-api.YOUR_REGION.amazonaws.com",
        "Stage": "prod",
        "Path": "/api/v1/endpoint5/documents/release",
        "Method": "POST",
        "AuthType": "NO_AUTH",
        "RequestBody": { "saleId.$": "$.sale.saleId", "documentId.$": "$.document.documentId" }
      },
      "ResultSelector": { "status.$": "$.ResponseBody.status", "downloadUrl.$": "$.ResponseBody.downloadUrl" },
      "ResultPath": "$.release",
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "BackoffRate": 2.0, "MaxAttempts": 7 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "WorkflowFailed" }],
      "End": true
    },
    "WorkflowFailed": {
      "Type": "Fail",
      "Error": "DocsWorkflowFailed",
      "Cause": "Un paso agotó sus reintentos configurados."
    }
  }
}